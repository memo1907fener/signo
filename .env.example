APP_NAME=Signo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://signo.at
APP_TIMEZONE=Europe/Vienna

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_AT

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=signo
DB_USERNAME=signo
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hallo@signo.at"
MAIL_FROM_NAME="Signo"

# ---------- Signo ----------
# Wer sich mit dieser Adresse registriert, wird Admin (mehrere mit Komma)
SIGNO_ADMIN_EMAILS=
SIGNO_TRIAL_DAYS=14

# Firmendaten für Impressum, Datenschutz und AGB (\n = Zeilenumbruch)
SIGNO_COMPANY_NAME="Signo"
SIGNO_COMPANY_ADDRESS=""
SIGNO_COMPANY_EMAIL="hallo@signo.at"
SIGNO_COMPANY_PHONE=""
SIGNO_COMPANY_UID=""
SIGNO_COMPANY_REGISTER=""

# KI-Import (Claude). Schlüssel unter https://console.anthropic.com erstellen.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low
SIGNO_AI_DAILY_LIMIT=20

# Stripe (Zahlungen). Ohne Schlüssel bleibt die Bezahlung ausgeblendet.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_QR=
STRIPE_PRICE_SCREEN=
STRIPE_PRICE_MULTI=
